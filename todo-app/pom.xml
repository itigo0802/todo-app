<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>jp.itigotti</groupId>
  <artifactId>todo-app</artifactId>
  <version>1.0.0</version>
  <properties>
  	<maven.compiler.source>25</maven.compiler.source>
  	<maven.compiler.target>25</maven.compiler.target>
  	<javafx.version>25</javafx.version>
  </properties>

  <profiles>
	<profile>
		<id>linux-installer</id>
		<activation>
			<os>
				<family>unix</family>
				<name>Linux</name>
			</os>
			<property>
				<name>app.type</name>
				<value>installer</value>
			</property>
		</activation>
		<properties>
			<javafx.platform>linux</javafx.platform>
			<app.mode>installer</app.mode>
			<jpackage.type>DEB</jpackage.type>
		</properties>
	</profile>
	<profile>
		<id>linux-portable</id>
		<activation>
			<os>
				<family>unix</family>
				<name>Linux</name>
			</os>
			<activeByDefault>true</activeByDefault>
			<property>
				<name>app.type</name>
				<value>portable</value>
			</property>
		</activation>
		<properties>
			<javafx.platform>linux</javafx.platform>
			<app.mode>portable</app.mode>
			<jpackage.type>APP_IMAGE</jpackage.type>
		</properties>
	</profile>
	<profile>
		<id>windows-installer</id>
		<activation>
			<os>
				<family>windows</family>
			</os>
			<property>
				<name>app.type</name>
				<value>installer</value>
			</property>
		</activation>
		<properties>
			<javafx.platform>win</javafx.platform>
			<app.mode>installer</app.mode>
			<jpackage.type>MSI</jpackage.type>
		</properties>
	</profile>
	<profile>
		<id>windows-portable</id>
		<activation>
			<os>
				<family>windows</family>
			</os>
			<property>
				<name>app.type</name>
				<value>portable</value>
			</property>
		</activation>
		<properties>
			<javafx.platform>win</javafx.platform>
			<app.mode>portable</app.mode>
			<jpackage.type>APP_IMAGE</jpackage.type>
		</properties>
	</profile>
	<profile>
		<id>mac-installer</id>
		<activation>
			<os>
				<family>mac</family>
			</os>
			<property>
				<name>app.type</name>
				<value>installer</value>
			</property>
		</activation>
		<properties>
			<javafx.platform>mac</javafx.platform>
			<app.mode>installer</app.mode>
			<jpackage.type>PKG</jpackage.type>
		</properties>
	</profile>
	<profile>
		<id>mac-portable</id>
		<activation>
			<os>
				<family>mac</family>
			</os>
			<property>
				<name>app.type</name>
				<value>portable</value>
			</property>
		</activation>
		<properties>
			<javafx.platform>mac</javafx.platform>
			<app.mode>portable</app.mode>
			<jpackage.type>APP_IMAGE</jpackage.type>
		</properties>
	</profile>
  </profiles>
  <dependencies>
  	<dependency>
  	    <groupId>org.openjfx</groupId>
  		<artifactId>javafx-controls</artifactId>
  		<version>${javafx.version}</version>
		<classifier>${javafx.platform}</classifier>
  	</dependency>
  	<dependency>
  		<groupId>org.openjfx</groupId>
  		<artifactId>javafx-fxml</artifactId>
  		<version>${javafx.version}</version>
		<classifier>${javafx.platform}</classifier>
  	</dependency>
	<dependency>
		<groupId>org.xerial</groupId>
		<artifactId>sqlite-jdbc</artifactId>
		<version>3.53.2.1</version>
		<scope>compile</scope>
	</dependency>
	<dependency>
    	<groupId>org.junit.jupiter</groupId>
    	<artifactId>junit-jupiter</artifactId>
    	<version>5.11.4</version>
    	<scope>test</scope>
	</dependency>
	<dependency>
    	<groupId>org.mockito</groupId>
    	<artifactId>mockito-junit-jupiter</artifactId>
    	<version>5.21.0</version>
    	<scope>test</scope>
	</dependency>
	<dependency>
    	<groupId>org.testfx</groupId>
    	<artifactId>testfx-core</artifactId>
    	<version>4.0.18</version>
    	<scope>test</scope>
	</dependency>
	<dependency>
    	<groupId>org.testfx</groupId>
    	<artifactId>testfx-junit5</artifactId>
    	<version>4.0.18</version>
    	<scope>test</scope>
	</dependency>
	<dependency>
		<groupId>org.assertj</groupId>
		<artifactId>assertj-core</artifactId>
		<version>3.25.3</version>
		<scope>test</scope>
	</dependency>
	<dependency>
    	<groupId>org.slf4j</groupId>
    	<artifactId>slf4j-api</artifactId>
    	<version>2.0.18</version>
    	<scope>compile</scope>
	</dependency>
	<dependency>
    	<groupId>ch.qos.logback</groupId>
    	<artifactId>logback-classic</artifactId>
    	<version>1.6.1</version>
    	<scope>compile</scope>
	</dependency>
	<dependency>
    	<groupId>com.zaxxer</groupId>
    	<artifactId>HikariCP</artifactId>
    	<version>6.3.0</version>
    	<scope>compile</scope>
	</dependency>
  </dependencies>
  <build>
  	<plugins>
  		<plugin>
  			<groupId>org.openjfx</groupId>
  			<artifactId>javafx-maven-plugin</artifactId>
  			<version>0.0.8</version>
  			<configuration>
  				<mainClass>jp.itigotti/jp.itigotti.Main</mainClass>
				<compress>2</compress>
				<noHeaderFiles>true</noHeaderFiles>
				<noManPages>true</noManPages>
				<launcher>todo-app</launcher>
				<jlinkImageName>TodoApp</jlinkImageName>
				<jlinkZipName>TodoApp</jlinkZipName>
  			</configuration>
			<executions>
				<execution>
					<id>create-app-image</id>
					<phase>package</phase>
					<goals>
						<goal>jlink</goal>
					</goals>
				</execution>
			</executions>
  		</plugin>
		<plugin>
			<groupId>org.panteleyev</groupId>
			<artifactId>jpackage-maven-plugin</artifactId>
			<version>1.6.0</version>
			<executions>
				<execution>
					<id>jpackage</id>
					<phase>package</phase>
					<goals>
						<goal>jpackage</goal>
					</goals>
				</execution>
			</executions>
			<configuration>
				<name>TodoApp</name>
				<appVersion>1.0.0</appVersion>
				<vendor>jp.itigotti</vendor>
				<module>jp.itigotti/jp.itigotti.Main</module>
				<runtimeImage>${project.build.directory}/TodoApp</runtimeImage>
				<destination>${project.build.directory}/dist</destination>
				<type>${jpackage.type}</type>
				<javaOptions>
					<option>-Dtodo.app.mode=${app.mode}</option>
				</javaOptions>
			</configuration>
		</plugin>
		<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-compiler-plugin</artifactId>
			<version>3.14.1</version>
		</plugin>
		<plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.5</version>
        </plugin>
  	</plugins>
  </build>
</project>